{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-blocks/author-profile-meta",
	"title": "Author Meta",
	"category": "newspack",
	"parent": [ "newspack-blocks/author-profile" ],
	"description": "Display author metadata like job title, role, and employer.",
	"usesContext": [ "newspack-blocks/author" ],
	"textdomain": "newspack-blocks",
	"attributes": {
		"showJobTitle": {
			"type": "boolean",
			"default": true
		},
		"showRole": {
			"type": "boolean",
			"default": false
		},
		"showEmployer": {
			"type": "boolean",
			"default": false
		},
		"showPhone": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"color": {
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	}
}
