{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-blocks/author-profile-bio",
	"title": "Author Bio",
	"category": "newspack",
	"parent": [ "newspack-blocks/author-profile" ],
	"description": "Display the author's biographical text.",
	"usesContext": [ "newspack-blocks/author" ],
	"textdomain": "newspack-blocks",
	"attributes": {
		"truncate": {
			"type": "boolean",
			"default": false
		},
		"truncateLength": {
			"type": "number",
			"default": 200
		}
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"color": {
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	}
}
