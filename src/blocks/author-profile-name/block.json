{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "newspack-blocks/author-profile-name",
	"title": "Author Name",
	"category": "newspack",
	"parent": [ "newspack-blocks/author-profile" ],
	"description": "Display the author's name with optional link to archive.",
	"usesContext": [ "newspack-blocks/author" ],
	"textdomain": "newspack-blocks",
	"attributes": {
		"headingLevel": {
			"type": "number",
			"default": 3
		},
		"linkToArchive": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"color": {
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	}
}
